# Test outputs
tests/output/
test_output.pdf

# N-gram training corpus & cached model -- multi-GB/hundreds-of-MB, exceeds
# GitHub's 100MB file limit and shouldn't live in git history. Rebuild via
# tools/build_ngram_model.py --download (see CLAUDE.md).
data/corpus_kn/
data/ngram_model.pkl.gz

# Filtered literary corpus (tools/filter_literary_corpus.py output) -- same
# reasoning, derived from local source dumps, not meant to live in git.
data/corpus_literary/
data/corpus_literary_report.csv

# Raw Kanaja source docx (1.8GB) -- local copy of an external dump, not
# meant to live in git. Re-derive data/corpus_literary/ from this via
# tools/filter_literary_corpus.py if it's ever lost.
data/kanaja_docx_raw/

# Evaluation fixture page images -- 341MB of PNGs, and the noise in the
# degraded variants makes them incompressible. Regenerate deterministically
# (fixed seed + the bundled Noto font) with:
#     python tools/build_eval_set.py --docs 12 --degrade 0,1,2,3
# The level-0 reference texts ARE committed, so a change in what the harness
# scores against shows up as a reviewable diff.
tests/fixtures/eval/*.png
tests/fixtures/eval/*_d[123].txt
tests/fixtures/eval/*_d[123].para.txt

# The 589,521-entry Kannada dictionary IS committed, as data/kn_IN.dic.gz --
# 2.5MB gzipped against 18.4MB raw, and pipeline.correction.dictionary reads
# the .gz in place, so there is no decompression step and a fresh clone works.
# Only an uncompressed copy is ignored: it is a local convenience (drop a
# different .dic in to experiment) and it takes precedence over the .gz, so it
# must never be committed or it would pin everyone to one person's experiment.
data/kn_IN.dic

# Working files for building the dictionary -- multi-GB word dumps and
# intermediate builds. data/kn_IN.dic.gz is the shipped result.
extended_data/

# Real page/transcript fixtures live in tests/fixtures/real/ and ARE committed
# -- they are small, and they are the only honest measurement this pipeline
# has. Source images came from the "Image nd Txt" working folder.
